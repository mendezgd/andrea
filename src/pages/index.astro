---
/**
 * index.astro
 * ────────────
 * Página principal del contador.
 * Todos los props están aquí centralizados —
 * editá esta sección para personalizar el contenido
 * sin tocar los componentes.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Background from "../components/Background.astro";
import RainEffect from "../components/RainEffect.astro";
import Header from "../components/Header.astro";
import SubjectCard from "../components/SubjectCard.astro";
import MoneyDisplay from "../components/MoneyDisplay.astro";
import TimeGrid from "../components/TimeGrid.astro";
import FactPills from "../components/FactPills.astro";
import DonateButton from "../components/DonateButton.astro";
import DonationTracker from "../components/DonationTracker.astro";
import DonorWall from "../components/DonorWall.astro";
import Footer from "../components/Footer.astro";

// Leemos los donantes para calcular el total
import { donors } from "../data/donors";
const donationsTotal = donors.reduce((s, d) => s + d.amount, 0);

// ══════════════════════════════════════════
// CONFIGURACIÓN DE CONTENIDO
// Editá estos valores para personalizar todo.
// ══════════════════════════════════════════

const BG_IMAGE = "/images/subject2.webp";
const RAIN_IMAGE = "/images/subject.webp";
const RAIN_COUNT = 22;

const SHOW_NAME = "Gran Hermano · Generación Dorada";
const SUBJECT_NAME = "Andrea del Boca";
const ENTRY_DATE = "23/02/2026 a las 22:15 hs";
const ENTRY_NOTE = "Cocinando arroz y silbando desde entonces";

const PHOTO_SRC = "/images/subject.webp";
const PHOTO_ALT = "Andrea del Boca";
const SPEECH_TEXT = "🍚 ¡¿Quieren arroz?!";
const BADGE_TEXT = "💵 $6.000.000 / semana 💵";

const DONATE_HREF = "https://link.mercadopago.com.ar/fattiepox";
const DONATE_LABEL =
  "ayudame a ganarle a andrea (o al menos a comprar mi arroz) · alias: fattiepox";

const FOOTER_TEXT =
  "Contador en tiempo real · datos según Ángel de Brito (Bondi Live)";
---

<BaseLayout
  title="🤑 Andrea del Boca — Contador GH"
  description="Contador en tiempo real de las ganancias de Andrea del Boca en Gran Hermano."
>
  <Background imageSrc={BG_IMAGE} />
  <RainEffect imageSrc={RAIN_IMAGE} count={RAIN_COUNT} />

  <main class="page">
    <Header
      showName={SHOW_NAME}
      subjectName={SUBJECT_NAME}
      entryDate={ENTRY_DATE}
      entryNote={ENTRY_NOTE}
    />

    <SubjectCard
      imageSrc={PHOTO_SRC}
      imageAlt={PHOTO_ALT}
      speechText={SPEECH_TEXT}
      badgeText={BADGE_TEXT}
    />

    <div class="spacer"></div>

    <MoneyDisplay />

    <TimeGrid />

    <FactPills />

    <!-- donationsTotal se calcula desde donors.ts en build time -->
    <DonationTracker donationsTotal={donationsTotal} />

    <DonateButton href={DONATE_HREF} label={DONATE_LABEL} />

    <DonorWall />

    <Footer text={FOOTER_TEXT} />
  </main>

  <script src="../scripts/counter.js"></script>
</BaseLayout>

<style>
  .page {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 1.5rem 1rem 2rem;
    gap: 1rem;
  }

  .spacer {
    height: 0.5rem;
  }
</style>
