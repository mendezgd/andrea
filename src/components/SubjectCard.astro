---
/**
 * SubjectCard.astro
 * ──────────────────
 * Foto del sujeto con bocadillo y badge de sueldo.
 *
 * Props:
 *   imageSrc      — ruta a la foto del sujeto.
 *                   REEMPLAZÁ por la imagen que quieras.
 *   imageAlt      — texto alternativo de la imagen
 *   speechText    — texto del bocadillo sobre la foto
 *   badgeText     — texto del badge inferior
 */
interface Props {
  imageSrc?:  string;
  imageAlt?:  string;
  speechText?: string;
  badgeText?:  string;
}
const {
  imageSrc   = '/images/subject.jpg',
  imageAlt   = 'Andrea del Boca',
  speechText = '🍚 ¡¿Quieren arroz?!',
  badgeText  = '💵 $6.000.000 / semana 💵',
} = Astro.props;
---

<div class="card-wrapper">
  <div class="speech font-body">{speechText}</div>
  <img
    class="subject-img"
    src={imageSrc}
    alt={imageAlt}
    loading="eager"
  />
  <div class="badge font-body">{badgeText}</div>
</div>

<style>
  .card-wrapper {
    position: relative;
    width: min(260px, 55vw);
    animation: bounceIn 0.7s 0.2s ease both;
  }

  .subject-img {
    width: 100%;
    border: var(--border-width-heavy) solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-comic-lg);
    filter: saturate(1.1);
  }

  /* ── Bocadillo ── */
  .speech {
    position: absolute;
    top: -30px;
    right: -32px;
    background: #fff;
    color: var(--color-border);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.3rem 0.8rem;
    font-size: 0.82rem;
    white-space: nowrap;
    box-shadow: var(--shadow-comic-sm);
    animation: wiggle 3s ease-in-out infinite;
    z-index: 2;
  }
  .speech::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 18px;
    border: 7px solid transparent;
    border-top-color: var(--color-border);
  }
  .speech::before {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 20px;
    border: 5px solid transparent;
    border-top-color: #fff;
    z-index: 1;
  }

  /* ── Badge ── */
  .badge {
    position: absolute;
    bottom: -16px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-pink);
    color: #fff;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0.28rem 1.1rem;
    font-size: 0.85rem;
    white-space: nowrap;
    box-shadow: var(--shadow-comic-sm);
  }
</style>
