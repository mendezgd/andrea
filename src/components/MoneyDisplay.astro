---
/**
 * MoneyDisplay.astro
 * ───────────────────
 * El número grande verde con el monto acumulado.
 * El contenido se actualiza via JS (counter.js).
 */
---

<div class="money-card">
  <p class="label font-body">💰 Lleva ganado hasta ahora 💰</p>
  <div class="amount" id="moneyTotal">$0</div>
  <p class="sub font-body" id="rateSub">Calculando...</p>
</div>

<style>
  .money-card {
    background: var(--color-surface);
    border: var(--border-width-heavy) solid var(--color-green);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-xl);
    text-align: center;
    box-shadow: 8px 8px 0 var(--color-green);
    max-width: 700px;
    width: 100%;
    position: relative;
    overflow: hidden;
    animation: fadeUp 0.6s 0.4s ease both;
  }

  /* Decoración de fondo */
  .money-card::before {
    content: '💸 💸 💸';
    position: absolute;
    top: 6px; left: 10px;
    font-size: 1rem;
    opacity: 0.3;
    pointer-events: none;
  }
  .money-card::after {
    content: '💸 💸 💸';
    position: absolute;
    bottom: 6px; right: 10px;
    font-size: 1rem;
    opacity: 0.3;
    pointer-events: none;
  }

  .label {
    color: var(--color-muted);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .amount {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 9vw, 5.5rem);
    color: var(--color-green);
    line-height: 1;
    letter-spacing: 0.02em;
    animation: greenPulse 1.8s ease-in-out infinite;
  }

  .sub {
    color: var(--color-muted);
    font-size: 0.68rem;
    margin-top: 0.3rem;
    letter-spacing: 0.05em;
  }
</style>
