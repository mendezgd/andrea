---
/**
 * Header.astro
 * ─────────────
 * Cabecera con el título del show y nombre del sujeto.
 *
 * Props:
 *   showName    — nombre del programa / contexto
 *   subjectName — nombre de la persona
 *   entryDate   — fecha de ingreso formateada (string)
 *   entryNote   — nota extra debajo de la fecha
 */
interface Props {
  showName?:    string;
  subjectName?: string;
  entryDate?:   string;
  entryNote?:   string;
}
const {
  showName    = 'Gran Hermano · Generación Dorada',
  subjectName = 'Andrea del Boca',
  entryDate   = '23/02/2026 a las 22:15 hs',
  entryNote   = 'Cocinando arroz y silbando desde entonces',
} = Astro.props;
---

<header class="header-bubble">
  <p class="tag font-body">🎬 {showName} 🎬</p>
  <h1>🌟 {subjectName} 🌟</h1>
  <p class="sub font-body">Ingresó el {entryDate} · {entryNote}</p>
</header>

<style>
  .header-bubble {
    background: var(--color-yellow);
    color: var(--color-border);
    border: var(--border-width-heavy) solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-sm) var(--space-xl);
    box-shadow: var(--shadow-comic-lg);
    text-align: center;
    max-width: 700px;
    width: 100%;
    animation: bounceIn 0.6s ease both, subtleBlink 6s 2s ease-in-out infinite;
  }

  .tag {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #444;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 4.2rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-shadow: 3px 3px 0 rgba(0,0,0,0.15);
  }

  .sub {
    font-size: 0.78rem;
    color: #333;
    margin-top: 0.1rem;
  }
</style>
